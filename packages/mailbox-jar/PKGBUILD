package() {
  cd "${repodir}"

  install -D store/target/zm-store.jar \
    "${pkgdir}/opt/zextras/mailbox/jars/mailbox.jar"

  install -D store/target/dependencies/*.jar \
    "${pkgdir}/opt/zextras/mailbox/jars/"
}
