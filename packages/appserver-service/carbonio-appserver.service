[Unit]
Description=Carbonio Appserver Daemon
# carbonio-mailbox-sidecar provides the outbound DB mesh path (carbonio-mailbox-db)
# that mailboxd needs during its Zextras bootstrap; it must be up first.
# On stop and restart, the core DB mesh path (carbonio-mailbox-db-sidecar) must
# stay up until the appserver shutdown has finished, because the shutdown hook
# writes to the DB. Measured: the sidecar was stopped in parallel and the
# appserver hung until SIGKILL at 90 s. Ordering only (no Wants/Requires); it is
# a no-op where that unit does not exist (multi-server).
After=carbonio-appserver-db.service carbonio-configd.service carbonio-mailbox-sidecar.service carbonio-mailbox-db-sidecar.service
Wants=carbonio-appserver-db.service carbonio-configd.service carbonio-mailbox-sidecar.service carbonio-mailbox-internal-api-sidecar.service carbonio-authz-sidecar.service
PartOf=carbonio-appserver.target

[Service]
User=zextras
Type=notify
NotifyAccess=main
Environment=OTEL_JAVAAGENT_CONFIGURATION_FILE=/etc/carbonio/mailbox/otel.properties
EnvironmentFile=-/opt/zextras/data/systemd.env
# Only sasl and mailbox are zmconfigd.cf sections; configd ignores the
# legacy zmtlsctl names (webxml, service, zextras, zextrasAdmin, zimlet).
ExecStartPre=echo REWRITE sasl mailbox | netcat -w 120 localhost 7171
ExecStartPre=-/opt/zextras/bin/zmtlsctl
# carbonio-appserver-jvm-args writes jvm.args: the flat class path (mailbox jars
# then Carbonio Advanced extension jars) with -Dzal.flatClasspath=true and, on
# JDK >= 25 only, the AOT cache flags. The first start after an install or
# upgrade is a training run; the JVM writes the cache when it exits, which makes
# that one stop slow (~25 s on a slow VM), hence the generous TimeoutStopSec.
StateDirectory=carbonio-appserver
ExecStartPre=/usr/libexec/carbonio-appserver-jvm-args
ExecStart=/opt/zextras/common/bin/java \
  --enable-preview \
  --enable-native-access=ALL-UNNAMED \
  -Dfile.encoding=UTF-8 \
  $mailboxd_java_options \
  -Xms${java_xms}m \
  -Xmx${java_xmx}m \
  -Djava.io.tmpdir=/opt/zextras/mailboxd/work \
  -Dzimbra.config=/opt/zextras/conf/localconfig.xml \
  @/var/lib/carbonio-appserver/jvm.args \
  com.zextras.mailbox.Mailbox
LimitNOFILE=524288
TimeoutStartSec=300s
TimeoutStopSec=180s
RestartSec=3s
Restart=on-failure
SuccessExitStatus=143
StandardError=append:/opt/zextras/log/zmmailboxd.out

# Hardening
PrivateTmp=yes
#ProtectSystem=strict
#ReadWritePaths=/opt/zextras/backup
#ReadWritePaths=/opt/zextras/cache
#ReadWritePaths=/opt/zextras/conf
#ReadWritePaths=/opt/zextras/data
#ReadWritePaths=/opt/zextras/incoming
#ReadWritePaths=/opt/zextras/index
#ReadWritePaths=/opt/zextras/log
#ReadWritePaths=/opt/zextras/mailboxd
#ReadWritePaths=/opt/zextras/redolog
#ReadWritePaths=/opt/zextras/store
#ReadWritePaths=/opt/zextras/zmstat
#ReadWritePaths=/run/carbonio
ProtectSystem=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=carbonio-appserver.target
