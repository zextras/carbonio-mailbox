[Unit]
Description=Carbonio Mailbox Sidecar
Documentation=https://docs.zextras.com/
Requires=network-online.target
# NOTE: deliberately NOT ordered After=carbonio-appserver.service. This sidecar's
# Envoy provides the appserver's OUTBOUND upstreams (incl. the carbonio-mailbox-db
# core PostgreSQL at the local mesh bind), which mailboxd needs DURING its Zextras
# bootstrap. Ordering it after the appserver inverted that dependency and caused a
# cold-boot race: mailboxd's bootstrap failed to reach the DB, aborted before
# registering /zx/auth and binding the address-book port, and stayed unhealthy
# until a manual restart. carbonio-appserver.service now orders After= this unit.
After=network-online.target service-discover.service
PartOf=service-discover.target

[Service]
User=carbonio-mailbox
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/service-discover-wrapper.sh \
    -token-file /etc/carbonio/mailbox/service-discover/token \
    -admin-bind localhost:0 \
    -sidecar-for carbonio-mailbox
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=15s
KillSignal=SIGINT
LimitNOFILE=65536

# Hardening
PrivateTmp=yes
#ProtectSystem=strict
ProtectSystem=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=service-discover.target
